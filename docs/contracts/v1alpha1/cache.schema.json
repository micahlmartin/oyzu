{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyzu.example.invalid/schemas/v1alpha1/cache.schema.json",
  "title": "Oyzu cache draft v1alpha1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "kind": {
      "const": "action-result"
    },
    "actionKey": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recipeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inputDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "treeDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "archiveDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "treeDigest",
          "archiveDigest",
          "size"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report"
      },
      "minItems": 0
    },
    "executionPlatform": {
      "$ref": "#/$defs/platform"
    },
    "targetPlatform": {
      "$ref": "#/$defs/platform"
    },
    "enforced": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "producerEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "actionKey",
    "recipeDigest",
    "inputDigests",
    "outputs",
    "reports",
    "executionPlatform",
    "targetPlatform",
    "enforced",
    "producerEvidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "subjectDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "producer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "verification": {
          "enum": [
            "unverified",
            "verified",
            "local"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "kind",
        "subjectDigest",
        "producer",
        "verification"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "enum": [
            "linux",
            "windows",
            "darwin"
          ]
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "emulation": {
          "type": "boolean"
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "action": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "kind": {
          "enum": [
            "test",
            "coverage",
            "scan",
            "sbom",
            "lint",
            "format"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "collected",
            "not-detected",
            "unsupported",
            "disabled",
            "missing",
            "invalid"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subjectDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "summary": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "covered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "metric": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "action",
        "target",
        "kind",
        "format",
        "status",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
