{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyzu.example.invalid/schemas/v1alpha1/build.schema.json",
  "title": "Oyzu build.yaml draft v1alpha1",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 1024,
  "propertyNames": {
    "type": "string",
    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "uses": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
      },
      "depends_on": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "minItems": 0,
        "uniqueItems": true
      },
      "materialize": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "artifact": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "to": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "platform": {
        "type": "string",
        "minLength": 1
      },
      "matrix": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 64
          },
          "python": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 64
          },
          "node": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 64
          },
          "go": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 64
          },
          "rust": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 64
          },
          "java": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 64
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "container": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "entrypoint": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "base": {
                "type": "string",
                "minLength": 1
              },
              "user": {
                "type": "string",
                "pattern": "^[0-9]+:[0-9]+$"
              },
              "workdir": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        ]
      },
      "bindings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "artifact": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "image-reference"
            },
            "repository": {
              "type": "string",
              "pattern": "^/"
            },
            "digest": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "from",
            "artifact",
            "type",
            "repository",
            "digest"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "dependencies": {
        "enum": [
          "python/uv",
          "python/pip",
          "python/poetry",
          "node/npm",
          "node/pnpm",
          "node/yarn",
          "java/maven",
          "java/gradle",
          "java/ivy",
          "go/modules",
          "rust/cargo",
          "helm",
          "os/apt",
          "os/apk"
        ]
      }
    },
    "required": [
      "uses"
    ],
    "additionalProperties": false
  }
}
