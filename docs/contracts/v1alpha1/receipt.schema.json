{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyzu.example.invalid/schemas/v1alpha1/receipt.schema.json",
  "title": "Oyzu receipt draft v1alpha1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "kind": {
      "const": "publication-receipt"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "artifact": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "operation": {
            "enum": [
              "publish",
              "promote",
              "sign",
              "attest"
            ]
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "coordinate": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "planned",
              "authorized",
              "uploaded",
              "verified",
              "completed",
              "failed"
            ]
          },
          "decisionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "policyRevision": {
            "type": "string",
            "minLength": 1
          },
          "remoteDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "error": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "required": [
          "id",
          "idempotencyKey",
          "artifact",
          "artifactDigest",
          "operation",
          "destination",
          "coordinate",
          "state"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "manifestDigest",
    "status",
    "operations"
  ],
  "additionalProperties": false,
  "$defs": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "action": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        }
      },
      "required": [
        "code",
        "phase",
        "severity",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
