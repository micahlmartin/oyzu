{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyzu.example.invalid/schemas/v1alpha1/dependencies.schema.json",
  "title": "Oyzu dependencies draft v1alpha1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "kind": {
      "const": "dependency-snapshot"
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "layoutVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "digest",
        "layoutVersion"
      ],
      "additionalProperties": false
    },
    "manager": {
      "$ref": "#/$defs/tool"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lockDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0
    },
    "targetPlatform": {
      "$ref": "#/$defs/platform"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "purpose": {
            "enum": [
              "build",
              "runtime",
              "test",
              "scan",
              "tool"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "minItems": 0
          },
          "verification": {
            "enum": [
              "digest-only",
              "authenticated-digest",
              "publisher-signature"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "sourceId",
          "digest",
          "size",
          "purpose",
          "dependencies",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "preparedTree": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "adapter",
    "manager",
    "sourceDigest",
    "lockDigests",
    "targetPlatform",
    "packages",
    "preparedTree"
  ],
  "additionalProperties": false,
  "$defs": {
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "enum": [
            "linux",
            "windows",
            "darwin"
          ]
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "emulation": {
          "type": "boolean"
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "platform"
      ],
      "additionalProperties": false
    }
  }
}
