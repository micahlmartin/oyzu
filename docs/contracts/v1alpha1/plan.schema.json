{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyzu.example.invalid/schemas/v1alpha1/plan.schema.json",
  "title": "Oyzu plan draft v1alpha1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "kind": {
      "const": "build-plan"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "policy": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "standalone",
            "managed"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "enforcementDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "mode",
        "enforcementDigest",
        "requiredChecks"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      },
      "minItems": 0
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      },
      "minItems": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "minItems": 0
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "minItems": 0
          },
          "executionPlatform": {
            "$ref": "#/$defs/platform"
          },
          "targetPlatform": {
            "$ref": "#/$defs/platform"
          },
          "inputs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "tree",
                        "dependency"
                      ]
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "mount": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
                    }
                  },
                  "required": [
                    "kind",
                    "digest",
                    "mount"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "artifact"
                    },
                    "artifact": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
                    },
                    "producer": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
                    },
                    "mount": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
                    }
                  },
                  "required": [
                    "kind",
                    "artifact",
                    "producer",
                    "mount"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 0
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "minItems": 0
          },
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reportIntent"
            },
            "minItems": 0
          },
          "required": {
            "type": "boolean"
          },
          "cacheable": {
            "type": "boolean"
          },
          "network": {
            "enum": [
              "none",
              "scoped-service",
              "host"
            ]
          },
          "limits": {
            "type": "object",
            "properties": {
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cpu": {
                "type": "integer",
                "minimum": 1
              },
              "memoryBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "timeoutSeconds",
              "cpu",
              "memoryBytes",
              "outputBytes"
            ],
            "additionalProperties": false
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9.-]+/[A-Za-z0-9._-]+$"
            },
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "target",
          "operation",
          "dependsOn",
          "argv",
          "cwd",
          "env",
          "tools",
          "executionPlatform",
          "targetPlatform",
          "inputs",
          "outputs",
          "reports",
          "required",
          "cacheable",
          "network",
          "limits"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "network": {
                  "const": "host"
                }
              },
              "required": [
                "network"
              ]
            },
            "then": {
              "properties": {
                "cacheable": {
                  "const": false
                },
                "extensions": {
                  "required": [
                    "oyzu.dev/invocation",
                    "oyzu.dev/limits-enforced"
                  ],
                  "properties": {
                    "oyzu.dev/limits-enforced": {
                      "const": false
                    },
                    "oyzu.dev/invocation": {
                      "type": "object",
                      "properties": {
                        "execution": {
                          "const": "host"
                        },
                        "isolation": {
                          "const": "none"
                        },
                        "toolIdentity": {
                          "const": "unverified"
                        }
                      },
                      "required": [
                        "execution",
                        "isolation",
                        "toolIdentity"
                      ]
                    }
                  }
                }
              },
              "required": [
                "extensions"
              ]
            }
          }
        ]
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactIntent"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "source",
    "policy",
    "tools",
    "targets",
    "actions",
    "artifacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifactIntent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "producer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "oci-image",
            "oci-index",
            "chart"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
        }
      },
      "required": [
        "id",
        "target",
        "variant",
        "name",
        "producer",
        "kind",
        "version",
        "mediaType",
        "path"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "enum": [
            "linux",
            "windows",
            "darwin"
          ]
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "emulation": {
          "type": "boolean"
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "additionalProperties": false
    },
    "reportIntent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "kind": {
          "enum": [
            "test",
            "coverage",
            "scan",
            "sbom",
            "lint",
            "format"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "subject": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        }
      },
      "required": [
        "id",
        "kind",
        "format",
        "required",
        "subject"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "treeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "treeDigest",
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "builder": {
          "type": "string",
          "minLength": 1
        },
        "builderDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\x00-\\x1f]+$"
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9.-]+/[A-Za-z0-9._-]+$"
          },
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "builder",
        "builderDigest",
        "path",
        "variant",
        "platform"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "platform"
      ],
      "additionalProperties": false
    }
  }
}
