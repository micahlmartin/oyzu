{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft normalized Oyzu tool request identity (shape only)",
  "$comment": "Runtime additionally checks UTF-8 byte limits, total JSON/text budgets, catalog membership, sorted sets and recomputed digest. This is not a full worker operation or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requests",
    "native_constraints",
    "required_capabilities",
    "digest"
  ],
  "properties": {
    "requests": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "pattern": "^[^:\\s\\u0000-\\u001f\\u007f-\\u009f]+:[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
      }
    },
    "native_constraints": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "pattern": "^[^:\\s\\u0000-\\u001f\\u007f-\\u009f]+:[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16384,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_.:/-]+(?![\\s\\S])"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
