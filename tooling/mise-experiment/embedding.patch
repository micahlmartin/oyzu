+
+/// Experimental transport guard. Not a sandbox or a production connector API.
+/// The harness supplies this process-local route before starting worker threads.
+fn oyzu_experiment_route(url: &Url) -> Result<()> {
+    if let Ok(route) = std::env::var("OYZU_SPIKE_ROUTE") {
+        let allowed = Url::parse(&route)?;
+        ensure!(
+            url.origin() == allowed.origin()
+                && url
+                    .path()
+                    .starts_with(&format!("{}/", allowed.path().trim_end_matches('/'))),
+            "Oyzu experiment acquisition route denied"
+        );
+    }
+    Ok(())
+}
