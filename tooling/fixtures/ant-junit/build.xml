<project name="native-junit" default="jar">
  <path id="test.classpath">
    <pathelement path="build/classes"/>
    <pathelement location="${ant.home}/lib/junit-4.13.2.jar"/>
    <pathelement location="${ant.home}/lib/hamcrest-core-1.3.jar"/>
  </path>
  <target name="compile">
    <mkdir dir="build/classes"/>
    <javac srcdir="src" destdir="build/classes" release="17" debug="true" includeantruntime="false"/>
  </target>
  <target name="test" depends="compile">
    <javac srcdir="test" destdir="build/classes" release="17" debug="true" includeantruntime="false">
      <classpath refid="test.classpath"/>
    </javac>
    <mkdir dir="build/native-reports"/>
    <junit fork="true" forkmode="once" haltonfailure="false" haltonerror="false">
      <classpath refid="test.classpath"/>
      <formatter type="plain"/>
      <batchtest todir="build/native-reports"><fileset dir="test" includes="**/*Test.java"/></batchtest>
    </junit>
  </target>
  <target name="jar" depends="compile">
    <mkdir dir="dist"/>
    <jar destfile="dist/calculator.jar" basedir="build/classes"/>
  </target>
</project>
