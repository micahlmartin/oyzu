{
  "name": "oyzu-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "oyzu-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@oyzu-example/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@oyzu-example/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/app": {
      "name": "@oyzu-example/app",
      "version": "0.1.0",
      "dependencies": {
        "@oyzu-example/shared": "0.1.0"
      }
    },
    "packages/shared": {
      "name": "@oyzu-example/shared",
      "version": "0.1.0"
    }
  }
}
